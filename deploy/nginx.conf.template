# The browser only ever talks to this host. Everything under /api and /ws goes to ZeroClaw
# untouched, so its pairing tokens stay the only access check; this file adds none.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;
  client_max_body_size 25m;   # image uploads

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://$host; frame-ancestors 'none'; base-uri 'none'" always;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Resolved per request through the cluster DNS, so nginx starts (and keeps working)
  # while ZeroClaw is down or its Service is recreated.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
  set $zeroclaw "http://${ZEROCLAW_UPSTREAM}";

  location /api/ {
    proxy_pass $zeroclaw;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;   # as Envoy set it: the real client last
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 620s;
    proxy_send_timeout 620s;
    proxy_buffering off;
    proxy_request_buffering off;
  }

  # The chat stream: long-lived, pinged by ZeroClaw every 30 s; a turn can run for minutes.
  location /ws/ {
    proxy_pass $zeroclaw;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;   # as Envoy set it: the real client last
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
    access_log off;             # the query string names the session
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff always;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://$host; frame-ancestors 'none'; base-uri 'none'" always;
    try_files $uri /index.html;
  }
}
